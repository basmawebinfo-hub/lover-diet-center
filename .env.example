# Supabase — safe to commit (publishable key is public by design)
NEXT_PUBLIC_SUPABASE_URL=https://udkccnszlviujpshayzn.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_t8r3xoe5EcH1GFuBAVPiJQ_Ys-Wj1RU

# ------------------------------------------------------------------------
# Site
# ------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.loversdc.com

# ------------------------------------------------------------------------
# Resend (email delivery) — SERVER ONLY. Do NOT prefix with NEXT_PUBLIC_.
#
# Note: Supabase Auth sends its own emails (recovery, signup, magic link)
# via SMTP. Configure the same domain/sender in Supabase Dashboard ->
# Project Settings -> Auth -> SMTP Settings using Resend's SMTP credentials.
#
# The variables below are used by our own application-level email helper
# (lib/resend.ts) and the diagnostic endpoint /api/auth/send-test-email.
# ------------------------------------------------------------------------
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=support@loversdc.com
RESEND_FROM_NAME=Lover Diet Center

# ------------------------------------------------------------------------
# Supabase service role — SERVER ONLY. Never expose to the browser.
#
# Required by app/api/orders/guest/route.ts. Guest orders have user_id = NULL,
# which RLS hides from every client role, so the insert must run as service
# role. Without this the endpoint returns 503 "Ordering is not configured"
# and guest checkout is dead — with no other symptom.
# ------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=replace_me

# ------------------------------------------------------------------------
# Paymob (card payments) — SERVER ONLY.
#
# PAYMOB_API_KEY          -> Dashboard · Settings · Account Info
# PAYMOB_HMAC_SECRET      -> Dashboard · Settings · Account Info (HMAC)
#                            Required by the webhook. If it is missing, every
#                            callback is rejected and no order is ever marked
#                            paid.
# PAYMOB_INTEGRATION_ID_CARD -> Dashboard · Developers · Payment Integrations
# PAYMOB_IFRAME_ID        -> Dashboard · Developers · iframes
#
# Missing INTEGRATION_ID / IFRAME_ID makes /api/checkout/paymob return 503.
# ------------------------------------------------------------------------
PAYMOB_API_KEY=replace_me
PAYMOB_HMAC_SECRET=replace_me
PAYMOB_INTEGRATION_ID_CARD=replace_me
PAYMOB_IFRAME_ID=replace_me

# Optional Paymob overrides. Defaults shown — only set these to change them.
# PAYMOB_BASE_URL=https://accept.paymob.com/api
# PAYMOB_CURRENCY=AED
# PAYMOB_USD_TO_AED=3.67

# ------------------------------------------------------------------------
# Upstash Redis (rate limiting) — SERVER ONLY.
#
# The limiter fails OPEN when these are absent: requests are allowed without
# any check. Production must set both, otherwise auth endpoints are unthrottled.
# Verify with GET /api/rate-limit/diagnostic (admin session required) — it
# should report status "enforcing", not "fail_open".
# ------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=replace_me
UPSTASH_REDIS_REST_TOKEN=replace_me
